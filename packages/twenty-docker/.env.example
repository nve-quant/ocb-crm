# ============================================
# ONCHAIN BUREAU CRM - CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your values
# Generate secure passwords with: openssl rand -base64 32

# ============================================
# DOCKER IMAGE
# ============================================
TAG=onchain-bureau-crm

# ============================================
# SERVER CONFIGURATION
# ============================================
# For production: https://crm.onchainbureau.com
# For local dev: http://localhost:3000
SERVER_URL=http://localhost:3000

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=GENERATE_WITH_OPENSSL_RAND_BASE64_32
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# APPLICATION SECRET
# ============================================
# Generate with: openssl rand -base64 32
APP_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ============================================
# STORAGE CONFIGURATION (MinIO/S3)
# ============================================
# For self-hosted MinIO (recommended for production)
STORAGE_TYPE=s3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_NAME=twenty-crm-files
STORAGE_S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_32
STORAGE_S3_FORCE_PATH_STYLE=true

# For local development only (files lost on container restart)
# STORAGE_TYPE=local

# For AWS S3
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# STORAGE_S3_ENDPOINT=  # Leave empty for AWS S3

# For Backblaze B2
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=us-west-002
# STORAGE_S3_NAME=your-bucket-name
# STORAGE_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# AWS_ACCESS_KEY_ID=your-b2-key-id
# AWS_SECRET_ACCESS_KEY=your-b2-application-key

# ============================================
# OPTIONAL: EMAIL CONFIGURATION
# ============================================
# EMAIL_FROM_ADDRESS=noreply@onchainbureau.com
# EMAIL_FROM_NAME=Onchain Bureau CRM
# EMAIL_SYSTEM_ADDRESS=system@onchainbureau.com
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your-email@gmail.com
# EMAIL_SMTP_PASSWORD=your-app-password

# ============================================
# OPTIONAL: OAUTH PROVIDERS
# ============================================
# AUTH_GOOGLE_ENABLED=false
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# AUTH_MICROSOFT_ENABLED=false
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
